      <mxGeometry relative="1" as="geometry"/>
    </mxCell><mxCell id="14" value="&lt;b&gt;Why undo/redo is not stored&lt;/b&gt;&lt;br/&gt;Persisting edit history inflates map files and is not required for gameplay.&lt;br/&gt;Keeping it in-memory keeps saves small, fast, and compatible with runtime." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
