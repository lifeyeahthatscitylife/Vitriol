<mxfile host="app.diagrams.net" modified="2026-01-09T10:24:52Z" agent="ChatGPT" version="22.1.0" type="device"><diagram name="Editor_Map_Lifecycle" id="78b38b7d5cde4a6d991aeb5bde373fb5" compressed="false"><mxGraphModel dx="1300" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t1" value="Editor – Map Lifecycle (Create / Load / Save / Autosave)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="50" as="geometry" /></mxCell><mxCell id="u1" value="User actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="220" height="70" as="geometry" /></mxCell><mxCell id="u2" value="Create New Map&amp;lt;br/&amp;gt;(name + W/H)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="220" height="70" as="geometry" /></mxCell><mxCell id="u3" value="Load Map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="220" height="60" as="geometry" /></mxCell><mxCell id="u4" value="Edit (paint/event)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="220" height="70" as="geometry" /></mxCell><mxCell id="u5" value="Manual Save" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="220" height="60" as="geometry" /></mxCell><mxCell id="c1" value="MainWindow logic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="740" height="520" as="geometry" /></mxCell><mxCell id="c2" value="CreateEmptyMap(w,h)&amp;lt;br/&amp;gt;• tileSize=32&amp;lt;br/&amp;gt;• bg tiles = -1&amp;lt;br/&amp;gt;• collision=0&amp;lt;br/&amp;gt;• events=[]&amp;lt;br/&amp;gt;• tilesets refs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="150" width="320" height="120" as="geometry" /></mxCell><mxCell id="c3" value="SaveToFile(MapsFolder, mapId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="150" width="320" height="60" as="geometry" /></mxCell><mxCell id="c4" value="LoadMapFromPath(path)&amp;lt;br/&amp;gt;• set _currentMap/_path&amp;lt;br/&amp;gt;• ensure collision layer&amp;lt;br/&amp;gt;• init tileset states&amp;lt;br/&amp;gt;• build palette&amp;lt;br/&amp;gt;• render" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="300" width="690" height="130" as="geometry" /></mxCell><mxCell id="c5" value="ExecuteCommand(cmd)&amp;lt;br/&amp;gt;• cmd.Execute()&amp;lt;br/&amp;gt;• push undo stack&amp;lt;br/&amp;gt;• PersistMap() + Render" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="460" width="320" height="100" as="geometry" /></mxCell><mxCell id="c6" value="PersistMap()&amp;lt;br/&amp;gt;if path set AND (sample map OR has been manually saved once)&amp;lt;br/&amp;gt;→ MapSerializer.SaveToFile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="460" width="320" height="100" as="geometry" /></mxCell><mxCell id="note1" value="Rule: Sample map always autosaves.&amp;lt;br/&amp;gt;Rule: New maps must be manually saved once&amp;lt;br/&amp;gt;before autosave is enabled." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="580" width="690" height="60" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="u2" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="initial save" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="load into editor" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="u3" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="u4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="calls" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="Save button writes file + enables autosave" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="u5" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="sets flags/path" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>