      <mxGeometry x="560" y="140" width="260" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="cPaint" value="PaintIntCellCommand

- _kind:LayerKind
- _idx:int
- _oldValue:int
- _newValue:int

Execute→SetLayerCell(new)
Undo→SetLayerCell(old)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
      <mxGeometry x="560" y="290" width="310" height="200" as="geometry"/>
