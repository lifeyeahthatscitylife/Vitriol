    <mxCell id="cAdd" value="AddEventCommand

- _ev:MapEventDto
Execute→AddEvent
Undo→DeleteEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
